{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Test files are deliberately NOT entry points. When they were, a module kept
  // alive only by its own test counted as "used", which is how three dead
  // modules (utils/systemCatalog.ts, utils/validation.ts,
  // components/MonsterStatBlock.tsx) passed check:dead-code.
  "entry": [
    "src/scripts/**/*.ts",
    "scripts/**/*.mjs",
    "e2e/**/*.spec.ts",
    "*.config.{ts,js,mjs}",
    "docs/doc-drift.manifest.ts",
    "docs/doc-drift.rules.ts",
    "netlify/functions/*.mts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "netlify/functions/**/*.mts"],
  // `.claude/worktrees/` holds agent worktrees — full nested checkouts of this
  // repo. When they accumulate, knip walks every worktree's copy of src/ and
  // exhausts the heap: `FATAL ERROR: Reached heap limit` (exit 134), which
  // aborts `npm run verify` at check:dead-code so the remaining gates never run
  // locally. Same defect vitest.config.ts and eslint.config.js each carry an
  // exclude for.
  //
  // CORRECTED 2026-07-28. This comment used to claim the `.claude/**` entry
  // below PREVENTS that OOM, and that the entry is therefore load-bearing and
  // must never be removed. That is not what happens. Measured on this tree with
  // the entry present the whole time:
  //
  //   41 agent worktrees present (5.9 GB) -> FATAL heap limit, exit 134
  //   the same tree with the worktrees removed -> exit 0 in 7.8s
  //
  // So the ignore entry does not stop knip from traversing them. **The actual
  // remedy is to remove the worktrees** (`git worktree list`, then
  // `git worktree remove` the stale ones and `git worktree prune`) — removal
  // does not delete the branches, which stay in .git and on origin.
  //
  // The two entries are KEPT because they still suppress reporting noise from
  // any worktree that does exist, and they cost nothing. But they are not the
  // safeguard the old comment claimed, and nobody should rely on them as one.
  //
  // knip prints "Configuration hints (2) — remove from ignore" for these two
  // whenever no worktree happens to exist. Hints are informational; knip still
  // exits 0.
  "ignore": [
    ".claude/**",
    ".tmp/**",
    "src/__tests__/vitest.d.ts"
    // Deliberate seams that were exempted here are gone: knip itself now
    // reports all three as resolvable ("Configuration hints (3) — remove from
    // ignore"), and removing them leaves the gate exit-0 with no output. At
    // least one exemption was provably obsolete — it claimed makeMeAGameFlow.ts
    // was "deliberately not wired to a UI entry point yet", which stopped being
    // true when the character-draft flow got its entry point in 02d7b45. Three
    // modules are now subject to dead-code detection that were exempt from it.
    //
    // Do not add to this list without citing the doc that ratifies the seam,
    // AND re-checking that knip does not already resolve it.
  ],
  "ignoreDependencies": ["playwright-core"],
  "ignoreBinaries": ["graphify"],
  "rules": {
    "types": "off",
    "exports": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "nsTypes": "off",
    "nsExports": "off",
    "duplicates": "off"
  }
}
