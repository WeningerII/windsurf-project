# Sentry error monitoring (optional — app works without it)
VITE_SENTRY_DSN=

# Supabase backend (optional — app works offline without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI gateway (optional — app works fully without it; RFC 002)
# Build-time flag (browser): render AI affordances. Default off.
VITE_AI_ENABLED=
# Provider selection: 'gemini'/'google' (the default), 'anthropic'/'claude', or
# 'mock' (a deterministic, key-less adapter for CI/local — exercises the live
# path). Each provider reads only ITS OWN key below: setting another provider's
# key without setting AI_PROVIDER leaves the gateway off, by design.
AI_PROVIDER=
# SERVER-ONLY provider keys for the Netlify function — NOT VITE_ vars, so they
# are never exposed in the browser bundle. Without the selected provider's key
# the gateway degrades to manual tools.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional text-model override for the Gemini adapter (defaults to gemini-2.0-flash).
AI_GATEWAY_MODEL=
# Optional image-model override for illustrate-scene (defaults to imagen-4.0-fast-generate-001).
AI_IMAGE_MODEL=
# Key for AI_PROVIDER=anthropic. Text and vision only — that provider has no
# image-generation endpoint, so illustrate-scene fails there and falls back.
ANTHROPIC_API_KEY=
# Optional model override for the Anthropic adapter.
AI_ANTHROPIC_MODEL=
# Optional cost control: max gateway requests per client per window. Unset or
# <= 0 disables limiting (today's behavior). Exhaustion degrades to 429/manual.
AI_RATE_LIMIT=
# Rate-limit window length in milliseconds (defaults to 60000 when AI_RATE_LIMIT is set).
AI_RATE_LIMIT_WINDOW_MS=
