# Sentry error monitoring (optional — app works without it)
VITE_SENTRY_DSN=

# Supabase backend (optional — app works offline without these)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Staged-rollout feature flags (browser, build-time). Every one is ON only when
# set to exactly the string 'true'; any other value — including 'TRUE', '1' and
# empty — is OFF. Vite inlines them at build time, so flipping one means a
# REBUILD, not a restart: the flag-off bundle does not contain the guarded code.
# `VITE_AI_ENABLED` is the fourth and stays with the AI gateway block below,
# next to the server keys it degrades to without.
#
# The first three delegate to the registry in src/config/featureFlags.ts;
# VITE_SCENE_CANVAS_ENABLED deliberately does not (it is read directly so the
# canvas branch tree-shakes out of a flag-off build). That split is recorded in
# src/__tests__/config/featureFlagInventory.test.ts, which is also what fails if
# a flag lands in the code without landing here.
#
# Telemetry: build default only. A user's explicit opt-in/opt-out in
# localStorage always wins over this, so setting it does not collect from anyone
# who has already answered.
VITE_TELEMETRY_ENABLED=
# Phase 4: click-and-drag add-to-scene, replacing the legacy Place buttons.
VITE_SCENE_DRAG_ENABLED=
# Phase 6: the canvas scene surface. Mutually exclusive with the Phase-4 drag
# affordance in the product — the canvas branch suppresses the drop controller —
# so do not stage both on at once.
VITE_SCENE_CANVAS_ENABLED=

# AI gateway (optional — app works fully without it; RFC 002)
# Build-time flag (browser): render AI affordances. Default off.
VITE_AI_ENABLED=
# Provider selection: 'gemini'/'google' (the default), 'anthropic'/'claude', or
# 'mock' (a deterministic, key-less adapter for CI/local — exercises the live
# path). Each provider reads only ITS OWN key below: setting another provider's
# key without setting AI_PROVIDER leaves the gateway off, by design.
AI_PROVIDER=
# SERVER-ONLY provider keys for the Netlify function — NOT VITE_ vars, so they
# are never exposed in the browser bundle. Without the selected provider's key
# the gateway degrades to manual tools.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional text-model override for the Gemini adapter (defaults to gemini-2.0-flash).
AI_GATEWAY_MODEL=
# Optional image-model override for illustrate-scene (defaults to imagen-4.0-fast-generate-001).
AI_IMAGE_MODEL=
# Key for AI_PROVIDER=anthropic. Text and vision only — that provider has no
# image-generation endpoint, so illustrate-scene fails there and falls back.
ANTHROPIC_API_KEY=
# Optional model override for the Anthropic adapter.
AI_ANTHROPIC_MODEL=
# Optional cost control: max gateway requests per client per window. Unset or
# <= 0 disables limiting (today's behavior). Exhaustion degrades to 429/manual.
AI_RATE_LIMIT=
# Rate-limit window length in milliseconds (defaults to 60000 when AI_RATE_LIMIT is set).
AI_RATE_LIMIT_WINDOW_MS=
