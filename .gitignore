# TypeScript incremental / project-reference build cache
*.tsbuildinfo

# Environment files (never commit secrets). Keep .env.example as the template.
.env
.env.*
!.env.example

# TypeDoc generated API docs
docs/api

# Report files
*-report.txt
spell-report.txt
playwright-report/
test-results/
# Per-system SRD manifests: ON-DEMAND, provenance-only. They are generated FROM
# the loaders (`npm run srd:manifests`), so committing them created a circular
# denominator — the same ids on both sides of the ratio, which could only ever
# read 100%. Denominator A is now docs/generated/srd-coverage.md. The
# hand-authored docs/srd-manifest/types.ts and _exclusions.ts stay committed.
docs/srd-manifest/dnd5e-2014.ts
docs/srd-manifest/dnd5e-2024.ts
docs/srd-manifest/dnd35e.ts
docs/srd-manifest/pf1e.ts
docs/srd-manifest/pf2e.ts
docs/srd-manifest/mam3e.ts
docs/srd-manifest/daggerheart.ts
# Transient per-run diagnostic from check:compute-register (Tier A vs A+B content
# differs per flag); the committed honest metric is docs/generated/roadmap-metrics.*.
docs/generated/compute-register-gate.json
# Transient per-run timings from the user-outcome harness; the committed floor is
# e2e/outcome/baseline.json.
e2e/outcome/last-run.json

# Repo-pinned Node runtime files and local runtime cache
.cache/node-dist/
.cache/node-runtime/

# Local scratch workspace for one-off scripts and notes
scratch/
.tmp/

# Local agent/tooling artifacts (never commit)
.codex
.aider*

# Claude Code: project settings and commands are shared; local state is not
.claude/*
!.claude/settings.json
!.claude/commands/

# Obsidian workspace state (repo root opens as a vault; per-user config stays local)
.obsidian/

# graphify: graph.json, labels, GRAPH_REPORT.md and wiki/ are committed shared
# memory. Bulky regenerable artifacts are not — rebuild with:
#   npm run graph:vault       (per-symbol Obsidian vault -> graphify-out/obsidian/)
#   graphify cluster-only .   (graph.html visualization)
#
# graphify writes a dated backup of the curated graph on every `graph:update`
# (graphify-out/YYYY-MM-DD/). Those are regenerable snapshots of a regenerable
# artifact and nothing references them, but they were never actually ignored:
# the pattern below carried a trailing `)` and therefore only matched a
# directory literally named `2026-07-05/)`. `git check-ignore -v` reported NOT
# IGNORED for all eight dated directories, and 40 files / 51 MB accumulated
# against an 8.5 MB live graph — 75% of the tracked tree. The live graph,
# labels, GRAPH_REPORT.md and wiki/ stay committed; the dated backups do not.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/cache/
graphify-out/graph.html
graphify-out/GRAPH_TREE.html
graphify-out/obsidian/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
stats.html
